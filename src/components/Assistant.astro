    const understood: string[] = [];
    if (p.seller) { answers.project = 'vendre'; step = 'v1'; body.innerHTML = ''; msg(`J'ai compris : vous êtes propriétaire.`); render(true); return; }
    if (p.family) { answers.family = p.family; understood.push((FAMILY_LABELS as any)[p.family]?.toLowerCase() ?? p.family); }
    if (p.project) { answers.project = p.project; understood.push(p.project === 'louer' ? 'en location' : p.project === 'investir' ? 'investissement' : 'achat'); }
    if (p.budgetMax) { const loc = (answers.project ?? p.project) === 'louer'; answers.budget = `0-${p.budgetMax}`; understood.push(loc ? `jusqu'à ${p.budgetMax.toLocaleString('fr-FR')} €/mois` : `moins de ${p.budgetMax >= 1e6 ? (p.budgetMax / 1e6).toLocaleString('fr-FR') + ' M€' : p.budgetMax.toLocaleString('fr-FR') + ' €'}`); }
    if (p.minRooms) { answers.rooms = String(Math.min(5, p.minRooms)); understood.push(p.minRooms === 1 ? 'studio' : `${p.minRooms} pièces`); }
    if (p.minSurface) { answers.surface = String(p.minSurface >= 200 ? 200 : p.minSurface >= 100 ? 100 : p.minSurface >= 50 ? 50 : 0); understood.push(`${p.minSurface} m² minimum`); }
    if (p.districts?.length) { answers.districts = p.districts; understood.push(p.districts.map((d) => districtsData.find((x) => x.slug === d)?.name).join(', ')); }
    if (p.scope === 'cote-d-azur') { answers.districts = ['zone:cote-d-azur']; understood.push('Côte d\'Azur'); }
    if (p.features?.length) { answers.features = Array.from(new Set([...(answers.features ?? []), ...p.features])); understood.push(p.features.join(', ')); }
    if (!understood.length) { msg(`Je n'ai pas reconnu de critère dans « ${esc(text)} ». Répondez aux questions ci-dessous ou essayez : « 3 pièces vue mer Larvotto moins de 6 M€ ».`); return; }
    // Prochaine question manquante
    body.innerHTML = '';
    const missing: Step = !answers.family ? 'q1' : !answers.project ? 'q2' : answers.budget === undefined ? 'q3' : (answers.rooms === undefined && answers.surface === undefined && answers.family !== 'parking-cave') ? 'q4' : answers.districts === undefined ? 'q5' : answers.features === undefined ? 'q6' : !answers.timeline ? 'q7' : 'results';
    step = missing;
    msg(`J'ai compris : ${esc(understood.join(', '))}. ${missing === 'results' ? 'Voici vos résultats.' : 'Je complète avec quelques questions.'}`);
    render(true);
  }
  freeForm.addEventListener('submit', (e) => { e.preventDefault(); const v = freeInput.value.trim(); if (!v) return; answer(v, step); freeInput.value = ''; applyParsed(v); });

  // ───────── API publique ─────────
  (window as any).SMIR = Object.assign((window as any).SMIR ?? {}, { assistant: { open: (text?: string) => open(undefined, text), close, parse: parseQuery } });
</script>
