      }
      msg(`Voici les biens qui correspondent le mieux à votre recherche : ${esc(summary)}.`);
      matches.forEach(renderCard);
      const q = criteriaToQuery(c);
      const token = btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(c)))).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      const total = findMatches(ALL, c, 100).length;
      const el = document.createElement('div'); el.className = 'as-form';
      el.innerHTML = `<a class="btn btn-primary btn-block" href="/${c.transaction === 'location' ? 'louer' : 'acheter'}/?${q}&tri=pertinence&assistant=${token}">Voir les ${total} bien${total > 1 ? 's' : ''} correspondant${total > 1 ? 's' : ''}</a>
        <div class="cluster" style="justify-content:center"><a class="btn btn-ghost btn-sm" href="/contact/?objet=acheter&resume=${encodeURIComponent(summary)}">Prendre rendez-vous</a><a class="btn btn-ghost btn-sm" href="/contact/?objet=alerte">Créer une alerte</a><button type="button" class="btn btn-ghost btn-sm" data-edit>Modifier mes critères</button></div>`;
      el.querySelector('[data-edit]')!.addEventListener('click', () => { step = 'q1'; body.innerHTML = ''; render(true); });
      body.append(el); scrollEnd();
