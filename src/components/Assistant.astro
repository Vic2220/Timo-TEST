  /** Rejoue le fil des réponses déjà données (après « Modifier » ou « Retour »). */
  function replayAnswers() {
    const idx = ORDER.indexOf(step);
    const a = answers;
    const lines: Array<[Step, string | undefined]> = [
      ['q1', a.family ? ({ appartement: 'Appartement', villa: 'Villa / Maison', 'bureau-commerce': 'Bureau / Commerce', 'parking-cave': 'Parking / Cave', indecis: 'Je ne sais pas encore' } as any)[a.family] : undefined],
      ['q2', a.project ? ({ habiter: 'Acheter pour y vivre', investir: 'Investir', louer: 'Louer', vendre: 'Vendre, louer ou faire gérer mon bien' } as any)[a.project] : undefined],
      ['q3', a.budget !== undefined ? budgetLabel() : undefined],
      ['q4', a.rooms !== undefined || a.surface !== undefined ? [a.rooms ? (a.rooms === '1' ? 'Studio' : `${a.rooms} pièces${a.rooms === '5' ? ' et plus' : ''}`) : '', a.surface ? `≥ ${a.surface} m²` : ''].filter(Boolean).join(' · ') || 'Peu importe' : undefined],
      ['q5', a.districts !== undefined ? (a.districts.length ? a.districts.map((d) => districtsData.find((x) => x.slug === d)?.name ?? 'Côte d\'Azur').join(', ') : 'Conseillez-moi') : undefined],
      ['q6', a.features !== undefined ? (a.features.length ? a.features.join(', ') : 'Pas de critère particulier') : undefined],
      ['q7', a.timeline ? ({ immediat: 'Dès que possible', '3-mois': 'Dans les 3 mois', '6-12-mois': 'Dans l\'année', veille: 'Je me renseigne' } as any)[a.timeline] : undefined],
    ];
    for (const [s, l] of lines) { if (ORDER.indexOf(s) < idx && l) answer(l, s); }
  }
  function budgetLabel() { const b = answers.budget ?? ''; if (!b) return 'Budget non précisé'; const [min, max] = b.split('-').map((x) => x ? parseInt(x, 10) : null); const loc = answers.project === 'louer'; const f = (n: number) => loc ? `${n.toLocaleString('fr-FR')} €/mois` : n >= 1e6 ? `${(n / 1e6).toLocaleString('fr-FR')} M€` : `${n.toLocaleString('fr-FR')} €`; return max ? (min ? `${f(min)} – ${f(max)}` : `Jusqu'à ${f(max)}`) : `Plus de ${f(min!)}`; }

  // ───────── Critères & résultats ─────────
  function criteria(): Criteria {
    const a = answers; const [bmin, bmax] = (a.budget ?? '').split('-');
    const scope = a.districts?.some((d) => d.startsWith('zone:')) ? 'cote-d-azur' : 'tous';
    return {
      project: a.project ?? 'habiter', transaction: a.project === 'louer' ? 'location' : 'vente',
      family: (a.family as any) ?? 'indecis',
      budgetMin: bmin ? parseInt(bmin, 10) : null, budgetMax: bmax ? parseInt(bmax, 10) : null,
      minRooms: a.rooms ? parseInt(a.rooms, 10) : null, minSurface: a.surface ? parseInt(a.surface, 10) : null,
      districts: (a.districts ?? []).filter((d) => !d.startsWith('zone:')), scope, features: a.features ?? [], timeline: (a.timeline as any) ?? undefined,
    };
  }
  function countByDistrict() { const c = criteria(); c.districts = []; c.features = []; c.minRooms = null; c.minSurface = null; const out: Record<string, number> = {}; ALL.forEach((l) => { if (l.transaction !== c.transaction) return; if (c.family && c.family !== 'indecis' && l.family !== c.family && !(c.family === 'bureau-commerce' && l.mixedUse)) return; const key = l.country === 'Monaco' ? l.district : (l.country === 'France' || l.country === 'Italie') ? 'zone:cote-d-azur' : 'intl'; out[key] = (out[key] ?? 0) + 1; }); return out; }

  function renderResults() {
    const c = criteria();
    const sk = document.createElement('div'); sk.innerHTML = '<div class="skeleton sk"></div><div class="skeleton sk" style="margin-top:12px"></div>';
    const intro = msg(`Je compare vos critères aux ${ALL.filter((l) => l.transaction === c.transaction).length} biens disponibles…`);
    body.append(sk);
    setTimeout(() => {
      sk.remove(); intro.remove();
      const matches = findMatches(ALL, c, 5);
      const summary = [c.family && c.family !== 'indecis' ? FAMILY_LABELS[c.family as keyof typeof FAMILY_LABELS].toLowerCase() : 'tous types de biens', answers.budget ? budgetLabel().toLowerCase() : '', c.minRooms ? (c.minRooms === 1 ? 'studio' : `${c.minRooms} pièces`) : '', c.districts?.length ? c.districts.map((d) => districtsData.find((x) => x.slug === d)?.name).join(' ou ') : '', (c.features ?? []).slice(0, 2).join(', ')].filter(Boolean).join(', ');
      if (c.family === 'indecis' || !c.districts?.length) {
        const adv = document.createElement('p'); adv.className = 'district-advice';
        adv.textContent = c.transaction === 'location'
          ? 'Avec votre projet, trois quartiers se détachent : La Condamine (vie de quartier, gare), Fontvieille (familial, bureaux), Larvotto (plage).'
          : 'Avec votre budget et votre projet, trois quartiers se détachent : Carré d\'Or (prestige, commerces), Larvotto (plage), Fontvieille (moderne, familial).';
