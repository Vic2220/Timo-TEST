  function labelOf(f: HTMLElement) { return (f.querySelector('input:checked') as HTMLInputElement)?.closest('label')?.querySelector('strong')?.textContent ?? ''; }
  function labelOfName(f: HTMLElement, n: string) { const i = f.querySelector(`input[name=${n}]:checked`) as HTMLInputElement | null; return i && i.value !== '' ? i.closest('label')!.querySelector('strong')!.textContent! : ''; }
