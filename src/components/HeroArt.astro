---
/** Illustration principale du hero : Monaco, la baie, les immeubles et une arche art déco. */
---
<svg class="hero-art" viewBox="0 0 800 1000" role="img" aria-label="Illustration : la baie de Monaco, ses immeubles et le Rocher au soleil couchant" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id="ha-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--ill-sky-1)"/><stop offset="1" stop-color="var(--ill-sky-2)"/></linearGradient>
    <linearGradient id="ha-sea" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--ill-sea-1)"/><stop offset="1" stop-color="var(--ill-sea-2)"/></linearGradient>
    <linearGradient id="ha-gold" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="var(--ill-gold-1)"/><stop offset="1" stop-color="var(--ill-gold-2)"/></linearGradient>
    <linearGradient id="ha-stone" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--ill-stone-1)"/><stop offset="1" stop-color="var(--ill-stone-2)"/></linearGradient>
    <clipPath id="ha-arch"><path d="M80 1000 V380 A320 320 0 0 1 720 380 V1000Z"/></clipPath>
  </defs>
  <rect width="800" height="1000" fill="var(--bg-2)"/>
  <g clip-path="url(#ha-arch)">
    <rect width="800" height="1000" fill="url(#ha-sky)"/>
    <circle cx="520" cy="330" r="70" fill="url(#ha-gold)"/>
    <path d="M80 560 L200 470 L300 520 L380 430 L470 500 L560 440 L640 500 L720 450 V600 H80Z" fill="var(--ill-plant)" opacity=".55"/>
    <g fill="url(#ha-stone)">
      <rect x="120" y="500" width="70" height="200"/><rect x="210" y="440" width="90" height="260"/><rect x="320" y="480" width="60" height="220"/>
      <rect x="400" y="400" width="110" height="300"/><rect x="530" y="470" width="80" height="230"/><rect x="630" y="430" width="70" height="270"/>
    </g>
    <g stroke="var(--ill-gold-1)" stroke-width="1.5" opacity=".8">
      <path d="M130 540h50M130 580h50M130 620h50M130 660h50M220 480h70M220 520h70M220 560h70M220 600h70M220 640h70M410 440h90M410 480h90M410 520h90M410 560h90M410 600h90M410 640h90M540 510h60M540 550h60M540 590h60M540 630h60M640 470h50M640 510h50M640 550h50M640 590h50M640 630h50"/>
    </g>
    <rect x="80" y="700" width="640" height="300" fill="url(#ha-sea)"/>
    <g stroke="var(--ill-light)" stroke-width="2" fill="none" opacity=".45"><path d="M80 740q40-10 80 0t80 0 80 0 80 0 80 0 80 0 80 0 80 0"/><path d="M80 800q40-10 80 0t80 0 80 0 80 0 80 0 80 0 80 0 80 0"/></g>
    <g fill="var(--ill-light)"><path d="M180 850h150l-15 30H195Z"/><path d="M430 870h190l-18 34H448Z"/></g>
    <g fill="var(--ill-dark-1)"><rect x="252" y="780" width="4" height="70"/><rect x="520" y="790" width="4" height="80"/></g>
    <path d="M80 940 H720 V1000 H80Z" fill="var(--ill-dark-2)" opacity=".9"/>
    <path d="M80 940 H720" stroke="var(--ill-gold-1)" stroke-width="3"/>
  </g>
  <path d="M80 1000 V380 A320 320 0 0 1 720 380 V1000" fill="none" stroke="var(--accent)" stroke-width="3"/>
  <path d="M120 1000 V390 A280 280 0 0 1 680 390 V1000" fill="none" stroke="var(--accent)" stroke-width="1" opacity=".5"/>
</svg>
<style>.hero-art { inline-size: 100%; block-size: 100%; display: block; }</style>
