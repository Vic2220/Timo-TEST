---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Assistant from '../components/Assistant.astro';
import Toast from '../components/Toast.astro';
import Favorites from '../components/Favorites.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD supplémentaire (objet ou tableau) */
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  ogImage?: string;
  bodyClass?: string;
}
const { title, description = site.description, schema, noindex = false, ogImage, bodyClass = '' } = Astro.props;
const fullTitle = title === site.name ? `${site.name} — ${site.tagline}` : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com').href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: Astro.site?.href ?? 'https://example.com',
  telephone: site.phone.display,
  email: site.email,
  foundingDate: String(site.founded.group),
  address: { '@type': 'PostalAddress', streetAddress: '4 boulevard des Moulins', postalCode: '98000', addressLocality: 'Monaco', addressCountry: 'MC' },
  areaServed: ['Monaco', "Côte d'Azur", 'International'],
  memberOf: { '@type': 'Organization', name: 'Chambre Immobilière Monégasque' },
  knowsLanguage: ['fr', 'en', 'it', 'ru'],
};
const schemas = [org, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---
<!doctype html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F7F4EE" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121311" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap" />
    <script is:inline>
      // Thème : appliqué avant le rendu pour éviter le flash. Clé localStorage « smir-theme ».
      try { const t = localStorage.getItem('smir-theme'); if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t; } catch (e) {}
      document.documentElement.classList.remove('no-js');
    </script>
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={bodyClass}>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Assistant />
    <Toast />
    <Favorites />
    <script>
      // Reveal au scroll (progressive enhancement)
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.1 });
      document.querySelectorAll('.reveal').forEach((el, i) => { (el as HTMLElement).style.transitionDelay = `${Math.min(i % 6, 5) * 60}ms`; io.observe(el); });
    </script>
  </body>
</html>
<style is:global>
  body { min-height: 100dvh; display: flex; flex-direction: column; }
  main { flex: 1; }
  main:focus { outline: none; }
</style>
